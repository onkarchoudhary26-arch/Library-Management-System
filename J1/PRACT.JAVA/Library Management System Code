import java.util.*;
import java.io.*;

class Book {
    String id, title, author, issuedTo;

    Book(String id, String title, String author) {
        this.id = id;
        this.title = title;
        this.author = author;
        this.issuedTo = "";
    }
}

class Node {
    Book book;
    Node next;

    Node(Book book) {
        this.book = book;
        this.next = null;
    }
}

class Request {
    String bookId, studentName;

    Request(String bookId, String studentName) {
        this.bookId = bookId;
        this.studentName = studentName;
    }
}

class Library {
    Node head;
    HashMap<String, Book> bookMap = new HashMap<>();
    Queue<Request> waitingQueue = new LinkedList<>();
    int nextNumber = 101;

    // Add book using Linked List
    void addBook(String title, String author) {
        String id = "B" + nextNumber++;
        Book book = new Book(id, title, author);

        Node newNode = new Node(book);

        if (head == null) {
            head = newNode;
        } else {
            Node temp = head;
            while (temp.next != null) {
                temp = temp.next;
            }
            temp.next = newNode;
        }

        bookMap.put(id, book);
        System.out.println("Book added. ID: " + id +
                " | " + title + " | " + author);
    }

    // Display all books
    void displayBooks() {
        if (head == null) {
            System.out.println("No books in catalogue.");
            return;
        }

        Node temp = head;
        while (temp != null) {
            Book b = temp.book;
            System.out.println(b.id + " | " + b.title + " | " +
                    b.author + " | " +
                    (b.issuedTo.isEmpty() ? "Available" : "Issued to " + b.issuedTo));
            temp = temp.next;
        }
    }

    // Search by ID or Title
    void searchBook(String key) {
        boolean found = false;

        for (Book b : bookMap.values()) {
            if (b.id.equalsIgnoreCase(key) ||
                    b.title.toLowerCase().contains(key.toLowerCase())) {
                System.out.println(b.id + " | " + b.title + " | " +
                        b.author + " | " +
                        (b.issuedTo.isEmpty() ? "Available" : "Issued to " + b.issuedTo));
                found = true;
            }
        }

        if (!found) {
            System.out.println("Book " + key + " not found.");
        }
    }

    // Sort books alphabetically by title
    void sortBooks() {
        if (head == null) {
            System.out.println("No books to sort.");
            return;
        }

        for (Node i = head; i != null; i = i.next) {
            for (Node j = i.next; j != null; j = j.next) {
                if (i.book.title.compareToIgnoreCase(j.book.title) > 0) {
                    Book temp = i.book;
                    i.book = j.book;
                    j.book = temp;
                }
            }
        }

        System.out.println("Books sorted by title.");
        displayBooks();
    }

    // Issue book or add request to waiting queue
    void issueBook(String id, String student) {
        Book book = bookMap.get(id);

        if (book == null) {
            System.out.println("Book " + id + " not found.");
            return;
        }

        if (book.issuedTo.isEmpty()) {
            book.issuedTo = student;
            System.out.println("Book " + id + " assigned to " + student + ".");
        } else {
            int position = 1;

            for (Request r : waitingQueue) {
                if (r.bookId.equalsIgnoreCase(id)) {
                    position++;
                }
            }

            waitingQueue.add(new Request(id, student));
            System.out.println(student + " added to waiting queue. Position: " + position);
        }
    }

    // Return book and assign it to first waiting person (FIFO)
    void returnBook(String id) {
        Book book = bookMap.get(id);

        if (book == null) {
            System.out.println("Book " + id + " not found.");
            return;
        }

        if (book.issuedTo.isEmpty()) {
            System.out.println("Book " + id + " is not issued.");
            return;
        }

        System.out.println(book.id + " returned by " + book.issuedTo + ".");

        book.issuedTo = "";

        Queue<Request> tempQueue = new LinkedList<>();
        Request nextRequest = null;

        while (!waitingQueue.isEmpty()) {
            Request r = waitingQueue.poll();

            if (nextRequest == null && r.bookId.equalsIgnoreCase(id)) {
                nextRequest = r;
            } else {
                tempQueue.add(r);
            }
        }

        waitingQueue = tempQueue;

        if (nextRequest != null) {
            book.issuedTo = nextRequest.studentName;
            System.out.println("Book " + id + " assigned to " +
                    nextRequest.studentName + ".");
        } else {
            System.out.println("Book " + id + " is now available.");
        }
    }

    // Display waiting queue
    void displayQueue() {
        if (waitingQueue.isEmpty()) {
            System.out.println("Waiting queue is empty.");
            return;
        }

        System.out.println("Waiting Requests (FIFO):");
        for (Request r : waitingQueue) {
            System.out.println(r.bookId + " | " + r.studentName);
        }
    }

    // Save books and waiting queue to file
    void saveData() {
        try (PrintWriter pw = new PrintWriter(new FileWriter("library.txt"))) {
            for (Book b : bookMap.values()) {
                pw.println("B|" + b.id + "|" + b.title + "|" +
                        b.author + "|" + b.issuedTo);
            }

            for (Request r : waitingQueue) {
                pw.println("W|" + r.bookId + "|" + r.studentName);
            }

            System.out.println("Data saved successfully.");
        } catch (IOException e) {
            System.out.println("Error saving data.");
        }
    }

    // Load books and waiting queue from file
    void loadData() {
        File file = new File("library.txt");

        if (!file.exists()) {
            return;
        }

        try (BufferedReader br = new BufferedReader(new FileReader(file))) {
            String line;

            while ((line = br.readLine()) != null) {
                String[] data = line.split("\\|", -1);

                if (data[0].equals("B") && data.length >= 5) {
                    Book b = new Book(data[1], data[2], data[3]);
                    b.issuedTo = data[4];

                    Node newNode = new Node(b);

                    if (head == null) {
                        head = newNode;
                    } else {
                        Node temp = head;
                        while (temp.next != null) {
                            temp = temp.next;
                        }
                        temp.next = newNode;
                    }

                    bookMap.put(b.id, b);

                    int num = Integer.parseInt(b.id.substring(1));
                    if (num >= nextNumber) {
                        nextNumber = num + 1;
                    }

                } else if (data[0].equals("W") && data.length >= 3) {
                    waitingQueue.add(new Request(data[1], data[2]));
                }
            }

            System.out.println("Library data loaded.");
        } catch (Exception e) {
            System.out.println("Error loading data.");
        }
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        Library lib = new Library();

        lib.loadData();

        while (true) {
            System.out.println("\n===== LIBRARY MANAGEMENT SYSTEM =====");
            System.out.println("1. Add Book");
            System.out.println("2. Display Books");
            System.out.println("3. Search Book");
            System.out.println("4. Issue Book");
            System.out.println("5. Return Book");
            System.out.println("6. Sort Books");
            System.out.println("7. Display Waiting Queue");
            System.out.println("8. Save and Exit");
            System.out.print("Enter choice: ");

            int choice;
            try {
                choice = Integer.parseInt(sc.nextLine());
            } catch (Exception e) {
                System.out.println("Invalid choice.");
                continue;
            }

            switch (choice) {
                case 1:
                    System.out.print("Enter book title: ");
                    String title = sc.nextLine().trim();

                    System.out.print("Enter author name: ");
                    String author = sc.nextLine().trim();

                    if (title.isEmpty() || author.isEmpty()) {
                        System.out.println("Title and author cannot be empty.");
                    } else {
                        lib.addBook(title, author);
                    }
                    break;

                case 2:
                    lib.displayBooks();
                    break;

                case 3:
                    System.out.print("Enter book ID or title: ");
                    lib.searchBook(sc.nextLine().trim());
                    break;

                case 4:
                    System.out.print("Enter book ID: ");
                    String issueId = sc.nextLine().trim().toUpperCase();

                    System.out.print("Enter student name: ");
                    String student = sc.nextLine().trim();

                    if (student.isEmpty()) {
                        System.out.println("Student name cannot be empty.");
                    } else {
                        lib.issueBook(issueId, student);
                    }
                    break;

                case 5:
                    System.out.print("Enter book ID to return: ");
                    lib.returnBook(sc.nextLine().trim().toUpperCase());
                    break;

                case 6:
                    lib.sortBooks();
                    break;

                case 7:
                    lib.displayQueue();
                    break;

                case 8:
                    lib.saveData();
                    System.out.println("Exiting program.");
                    sc.close();
                    return;

                default:
                    System.out.println("Invalid choice.");
            }
        }
    }
}
